# ==============================================================================
# OpenLense - Quick Start Environment Configuration
# ==============================================================================

# -----------------
# Backend Settings
# -----------------
# Google Gemini API Key (Vision Analysis & Persona Chat)
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud API Key (Document RAG with Llama 3.1)
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# -----------------
# Frontend Settings
# -----------------
NEXT_PUBLIC_VISION_API_URL=http://localhost:8001
NEXT_PUBLIC_RAG_API_URL=http://127.0.0.1:8002
NEXT_PUBLIC_API_URL=http://localhost:8000
