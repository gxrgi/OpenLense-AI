# ==============================================================================
# OpenLense Backend Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your API keys:
# cp .env.example .env

# Google Gemini API Key (Required for Vision Entity Extraction & Object Persona Chat)
# Obtain from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud API Key (Required for Document Ingestion & RAG Chat with Llama-3.1)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace Embeddings Model for Document RAG (Optional)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Server Port (Optional, default: 8000 for unified, 8001 for vision, 8002 for RAG)
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
