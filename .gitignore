# ==============================================================================
# OpenLense - Root .gitignore
# ==============================================================================

# Python Virtual Environments
venv/
.venv/
env/
ENV/
.env/
.python-version
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Node.js & Next.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
.vercel/
frontend/.vercel/
*.tsbuildinfo
next-env.d.ts
frontend/next-env.d.ts

# Runtime Uploads & Artifacts
backend/experts/uploads/*
!backend/experts/uploads/.gitkeep
backend/upload/*
!backend/upload/.gitkeep
backend/response/
backend/uploads/
uploads/
*.tmp
*.temp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
